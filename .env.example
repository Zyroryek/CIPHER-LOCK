# ZERO//DAY — TECH ESCAPE LAB CONFIGURATION

# Application URL
APP_URL="http://localhost:3000"

# Optional: Supabase PostgreSQL & Auth integration
# If not provided, the application automatically uses its high-integrity built-in persistent storage engine.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side Supabase Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Organizer Master Passcode (for admin dashboard and scenario controls)
ORGANIZER_SECRET_PASS="ZERO_DAY_ADMIN_2026"

# Port (Defaults to 3000)
PORT=3000
